<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SmartCalc AI"
            android:textColor="#E6D01B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Quick Voice Launch -->
        <TextView
            android:id="@+id/widget_btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_voice_bg"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🎙️ Voice"
            android:textColor="#141413"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <!-- Quick Floating Bubble Launch -->
        <TextView
            android:id="@+id/widget_btn_float"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_pill_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="❐ Float"
            android:textColor="#F5F5F0"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <!-- Open Main App -->
        <TextView
            android:id="@+id/widget_btn_app"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_pill_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⤢ App"
            android:textColor="#F5F5F0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Calculation Screen Display -->
    <TextView
        android:id="@+id/widget_display"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/widget_display_bg"
        android:gravity="end|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="0"
        android:textColor="#F5F5F0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:ellipsize="start" />

    <!-- Keypad Row 1: C, (, ), ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_btn_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_op_bg"
            android:gravity="center"
            android:text="C"
            android:textColor="#181815"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_lparen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_op_bg"
            android:gravity="center"
            android:text="("
            android:textColor="#181815"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_rparen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_op_bg"
            android:gravity="center"
            android:text=")"
            android:textColor="#181815"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_div"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_op_bg"
            android:gravity="center"
            android:text="÷"
            android:textColor="#181815"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 2: 7, 8, 9, × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_btn_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="7"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="8"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="9"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_mul"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_op_bg"
            android:gravity="center"
            android:text="×"
            android:textColor="#181815"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 3: 4, 5, 6, - -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_btn_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="4"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="5"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="6"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_sub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_op_bg"
            android:gravity="center"
            android:text="-"
            android:textColor="#181815"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 4: 1, 2, 3, + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_btn_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="1"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="2"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="3"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_op_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#181815"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 5: 0, ., ⌫, = -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="0"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_dot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="."
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_num_bg"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#F5F5F0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_equals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_equals_bg"
            android:gravity="center"
            android:text="="
            android:textColor="#141413"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
