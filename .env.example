# ============================================================================
# SmartCalc AI - Environment Configuration
# Copy this file to `.env` and fill in your credentials.
# Never commit `.env` with real API keys to version control!
# ============================================================================

# AI Provider Selection: "openai" | "gemini" | "groq" | "anthropic" | "custom" | "mock"
EXPO_PUBLIC_AI_PROVIDER=openai

# AI API Key (Required for live AI providers; leave empty to use built-in deterministic NL parser / mock mode)
EXPO_PUBLIC_AI_API_KEY=

# AI Base URL (Change to switch between OpenAI, Gemini OpenAI-compat, Groq, Ollama, etc.)
# Examples:
#   OpenAI:    https://api.openai.com/v1
#   Groq:      https://api.groq.com/openai/v1
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic: https://api.anthropic.com/v1
EXPO_PUBLIC_AI_BASE_URL=https://api.openai.com/v1

# AI Model Identifier
# Examples: gpt-4o-mini, gemini-2.5-flash, llama-3.3-70b-versatile, claude-3-5-haiku-latest
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini

# Request Timeout in milliseconds
EXPO_PUBLIC_AI_TIMEOUT_MS=10000

# Optional Live Currency Exchange Rate API Configuration
# Uses standard JSON rates endpoint; never invents rates if offline or unconfigured
EXPO_PUBLIC_CURRENCY_API_URL=https://open.er-api.com/v6/latest
EXPO_PUBLIC_CURRENCY_API_KEY=
